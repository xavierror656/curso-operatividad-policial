---
import '../styles/global.css'
import Head from '../components/Head.astro'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Operatividad policial · Curso 3',
  description = 'Herramientas tecnológicas orientadas a la operatividad policial: temario, sesiones y diapositivas del curso.',
} = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const path = Astro.url.pathname
const links = [
  { href: `${base}/#temario`, label: 'Temario', active: false },
  { href: `${base}/diapositivas/`, label: 'Diapositivas', active: path.includes('/diapositivas') },
  { href: `${base}/participante/dia-1/`, label: 'Participantes', active: path.includes('/participante') },
  { href: `${base}/practica/`, label: 'Práctica', active: path.includes('/practica') },
  { href: `${base}/cuestionario/`, label: 'Cuestionario', active: path.includes('/cuestionario') },
  { href: `${base}/cierre/`, label: 'Cierre', active: path.includes('/cierre') },
]
---

<!doctype html>
<html lang="es-MX" data-theme="karsam">
  <head>
    <Head title={title} description={description} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#contenido" class="btn btn-primary sr-only z-50 focus:not-sr-only focus:fixed focus:start-4 focus:top-4">Saltar al contenido</a>

    <nav class="navbar sticky top-0 z-30 flex-col border-b border-base-content/10 bg-base-100/95 backdrop-blur max-md:px-4 print:hidden" aria-label="Principal">
      <div class="mx-auto flex w-full max-w-6xl items-center gap-4 md:px-6">
        <a href={`${base}/`} class="flex items-center gap-3 no-underline">
          <span class="grid size-9 place-items-center rounded-md bg-primary text-primary-content">
            <span class="icon-[tabler--shield-check] size-5" aria-hidden="true"></span>
          </span>
          <span class="font-display leading-tight">
            <span class="block text-sm font-semibold">Operatividad policial</span>
            <span class="block text-xs text-base-content/65">Curso 3 · SSPM Ciudad Juárez</span>
          </span>
        </a>
        <ul class="menu menu-horizontal ms-auto gap-1 p-0 max-lg:hidden">
          {links.map((l) => (
            <li><a href={l.href} class:list={{ 'menu-active': l.active }} aria-current={l.active ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
        <a href={`${base}/diapositivas/`} class="btn btn-secondary btn-sm max-lg:ms-auto max-sm:hidden">
          <span class="icon-[tabler--presentation] size-4" aria-hidden="true"></span>Presentar
        </a>
        <button type="button" class="collapse-toggle btn btn-outline btn-square btn-sm max-sm:ms-auto lg:hidden" data-collapse="#menu-movil" aria-controls="menu-movil" aria-expanded="false" aria-label="Menú">
          <span class="icon-[tabler--menu-2] collapse-open:hidden size-5" aria-hidden="true"></span>
          <span class="icon-[tabler--x] collapse-open:block hidden size-5" aria-hidden="true"></span>
        </button>
      </div>
      <div id="menu-movil" class="collapse hidden w-full overflow-hidden transition-[height] duration-300 lg:hidden">
        <ul class="menu mx-auto max-w-6xl gap-1 px-0 py-3 md:px-6">
          {links.map((l) => (
            <li><a href={l.href} class:list={{ 'menu-active': l.active }} aria-current={l.active ? 'page' : undefined}>{l.label}</a></li>
          ))}
          <li class="sm:hidden"><a href={`${base}/diapositivas/`} class="btn btn-secondary btn-sm mt-1 justify-center">Presentar</a></li>
        </ul>
      </div>
    </nav>

    <main id="contenido" class="flex-1" tabindex="-1">
      <slot />
    </main>

    <footer class="bg-primary text-primary-content/75 print:hidden">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm md:flex-row md:justify-between md:px-6">
        <span>Herramientas tecnológicas orientadas a la operatividad policial · Grupo Karsam</span>
        <span class="flex flex-wrap gap-x-4 gap-y-1">
          <a class="link" href={`${base}/privacidad/`}>Privacidad</a>
          <a class="link" href={`${base}/datos/`}>Archivos del curso</a>
          <a class="link" href={`${base}/instructor/`}>Instructor</a>
          <span>CSV sintéticos y capas geográficas proporcionadas para el curso.</span>
        </span>
      </div>
    </footer>

    <script>
      import 'flyonui/flyonui'
    </script>
  </body>
</html>
