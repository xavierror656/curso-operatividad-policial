---
import Layout from '../layouts/Layout.astro'
import { href } from '../lib/site'
const flujos = [
  { id: 'recorrido', titulo: 'Recorrido del participante', texto: 'Cada sesión termina con un producto verificable. El Día 3 utiliza un conjunto ficticio distinto al de incidentes.', pasos: [
    ['Día 1 · Revisar', 'Diagnóstico de calidad y archivo de incidentes depurado.'],
    ['Día 2 · Representar', 'Proyecto de QGIS con capas, polígono propio y puntos filtrados.'],
    ['Día 3 · Comprobar', 'Tablero de IA y Metabase con tres gráficas y nota de datos simulados.'],
  ], enlace: '/diapositivas/', accion: 'Abrir las presentaciones' },
  { id: 'etl', titulo: 'Flujo ETL y calidad de datos', texto: 'La extracción, transformación y carga conservan un origen identificable y documentan las correcciones.', pasos: [
    ['Extraer', 'Conservar el archivo original y registrar de dónde proviene.'],
    ['Transformar', 'Revisar nulos, duplicados, fechas, texto y coordenadas.'],
    ['Validar', 'Comparar registros y anotar las reglas de limpieza aplicadas.'],
    ['Cargar', 'Guardar una copia depurada para el ejercicio.'],
  ], nota: 'Si la validación detecta errores, vuelva a transformar y valide de nuevo antes de cargar.', enlace: '/practica/detecta-errores/', accion: 'Practicar la revisión de calidad' },
  { id: 'qgis', titulo: 'Construcción del mapa en QGIS', texto: 'Trabaje con los archivos del curso y compruebe la posición de los puntos antes de interpretar el mapa.', pasos: [
    ['Preparar el mapa', 'Añadir el mapa base y revisar el sistema de coordenadas.'],
    ['Cargar las capas', 'Abrir los GeoJSON y guardar un polígono propio.'],
    ['Añadir puntos', 'Cargar el CSV sintético con longitud y latitud.'],
    ['Filtrar y guardar', 'Comprobar la ubicación, aplicar el filtro y guardar el proyecto.'],
  ], nota: 'Los nombres «Colonia Demo» del CSV no permiten una unión por nombre con las colonias reales.', enlace: '/datos/', accion: 'Abrir los archivos para QGIS' },
  { id: 'metabase', titulo: 'Construcción del tablero en Metabase', texto: 'La práctica utiliza datos ficticios sobre tareas, tiempo y revisión humana. La IA acompaña el trabajo y el participante comprueba el resultado.', pasos: [
    ['Plantear la pregunta', 'Elegir qué comparar y qué unidad mostrar.'],
    ['Crear las gráficas', 'Trabajar tareas, tiempo con y sin IA y estado de revisión humana.'],
    ['Comprobar', 'Contrastar conteos y promedios con los registros de práctica.'],
    ['Presentar', 'Reunir tres gráficas y añadir la nota de datos simulados.'],
  ], nota: 'Si un conteo o promedio no coincide, revise filtros y agrupaciones antes de presentar.', enlace: '/metabase/', accion: 'Abrir los tres trabajos guiados' },
]
---
<Layout title="Diagramas del curso · Operatividad policial">
  <section class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <a href={href('/recursos/')} class="link text-sm">Biblioteca de recursos</a>
    <h1 class="mt-5 text-4xl font-semibold">Diagramas del curso</h1>
    <p class="mt-4 max-w-3xl text-lg">Siga cada procedimiento de izquierda a derecha. En el celular, los pasos aparecen de arriba abajo.</p>
    <nav aria-label="Diagramas disponibles" class="mt-6 flex flex-wrap gap-3 print:hidden">{flujos.map(f => <a class="btn btn-outline btn-sm" href={`#${f.id}`}>{f.titulo}</a>)}</nav>
    <button id="imprimir" type="button" class="btn btn-primary mt-4 print:hidden" hidden>Imprimir o guardar PDF</button>
    {flujos.map(f => (
      <section id={f.id} class="flujo mt-12 scroll-mt-24 border-t border-base-content/15 pt-8" aria-labelledby={`titulo-${f.id}`}>
        <h2 id={`titulo-${f.id}`} class="text-2xl font-semibold">{f.titulo}</h2>
        <p class="mt-3 max-w-3xl">{f.texto}</p>
        <ol class="pasos mt-7" style={`--pasos: ${f.pasos.length}`}>
          {f.pasos.map(([titulo, descripcion], i) => <li><span class="numero" aria-hidden="true">{i + 1}</span><h3 class="font-semibold">{titulo}</h3><p class="mt-2">{descripcion}</p></li>)}
        </ol>
        {f.nota && <p class="mt-5 max-w-3xl"><strong>Comprobación:</strong> {f.nota}</p>}
        <a class="link mt-5 inline-block print:hidden" href={href(f.enlace)}>{f.accion}</a>
      </section>
    ))}
  </section>
</Layout>
<style>
  [hidden] { display: none !important; }
  .pasos { display: grid; grid-template-columns: repeat(var(--pasos), minmax(0, 1fr)); gap: 2rem; }
  .pasos li { position: relative; background: var(--color-base-200); padding: 1.25rem; border-radius: .75rem; }
  .numero { display: inline-grid; place-items: center; width: 2rem; height: 2rem; margin-bottom: 1rem; background: var(--color-primary); color: white; border-radius: 50%; font-variant-numeric: tabular-nums; }
  .pasos li:not(:last-child)::after { content: ''; position: absolute; right: -1.65rem; top: 50%; width: 1.2rem; height: .65rem; background: var(--color-secondary); clip-path: polygon(0 35%, 65% 35%, 65% 0, 100% 50%, 65% 100%, 65% 65%, 0 65%); }
  @media (max-width: 767px) { .pasos { grid-template-columns: 1fr; } .pasos li:not(:last-child)::after { top: auto; bottom: -1.3rem; right: calc(50% - .6rem); transform: rotate(90deg); } }
  @media print { .flujo { break-inside: avoid; } .pasos { grid-template-columns: repeat(var(--pasos), minmax(0, 1fr)); } .pasos li { border: 1px solid #666; } .numero { color: #191b2d; background: white; } .pasos li::after { display: none; } }
</style>
<script>
  const boton = document.querySelector<HTMLButtonElement>('#imprimir')!
  boton.hidden = false
  boton.addEventListener('click', () => window.print())
</script>
