---
import Layout from '../../../layouts/Layout.astro'
import Slide from '../../../components/slides/Slide.astro'
import '../../../styles/slides.css'
import { decksAbiertos } from '../../../data/decks'
import type { Deck } from '../../../data/types'
import { href } from '../../../lib/site'

export function getStaticPaths() {
  return decksAbiertos.map((deck) => ({ params: { slug: deck.slug }, props: { deck } }))
}

const { deck } = Astro.props as { deck: Deck }
const total = deck.slides.length
const isDay2 = deck.day === 2
const blockLabel = (id: string) => {
  const b = deck.blocks.find((x) => x.id === id)
  return `${/^\d/.test(id) ? `${id} · ` : ''}${b?.label ?? id}`
}

// Lista de revisión del prompt de diapositivas, apartado 4
const revision = [
  'Ninguna diapositiva contiene datos reales identificables.',
  'La regla de oro aparece antes del primer ejercicio con asistente.',
  'Los marcadores [CAPTURA] están sustituidos por pantallas reales.',
  'Los tiempos suman las 4 horas, incluido el receso.',
  'El entregable del día está en una diapositiva propia.',
  'Todo término técnico nuevo se explica en la misma diapositiva.',
]
const capturas = deck.slides.map((s, i) => ({ s, i })).filter(({ s }) => s.capture && !s.captureImage)
---

<Layout title={`Guion del instructor · Día ${deck.day}`}>
  {isDay2 ? (
    <article class="guion guion--day2 mx-auto max-w-6xl px-4 pb-16 pt-6 md:px-6">
      <header class="guion-cover">
        <div class="guion-cover-copy">
          <a href={href(`/diapositivas/${deck.slug}/`)} class="guion-back print:hidden"><span class="icon-[tabler--arrow-left] size-4" aria-hidden="true"></span>Volver a las diapositivas</a>
          <h1>{deck.title}</h1>
          <div class="guion-session-meta"><span>Día 2</span><span>{deck.schedule}</span><span>{total} diapositivas</span></div>
          <p>{deck.objective}</p>
        </div>
        <div class="guion-cover-actions print:hidden">
          <a href={href(`/diapositivas/${deck.slug}/`)} class="btn btn-secondary"><span class="icon-[tabler--presentation] size-5" aria-hidden="true"></span>Abrir presentación</a>
          <button type="button" class="btn btn-outline" onclick="window.print()"><span class="icon-[tabler--printer] size-5" aria-hidden="true"></span>Imprimir guion</button>
        </div>
      </header>

      <nav class="guion-jump print:hidden" aria-label="Secciones del guion">
        <a href="#preparacion"><span class="icon-[tabler--checklist] size-5" aria-hidden="true"></span>Preparación</a>
        <a href="#cronograma"><span class="icon-[tabler--clock] size-5" aria-hidden="true"></span>Cronograma</a>
        <a href="#notas"><span class="icon-[tabler--notes] size-5" aria-hidden="true"></span>Notas por diapositiva</a>
      </nav>

      <section id="preparacion" class="guion-section">
        <div class="guion-section-heading">
          <h2>Antes de impartir</h2>
          <p>Prepare el mismo punto de partida para todo el grupo.</p>
        </div>
        <div class="guion-prep-grid">
          <div class="guion-prep-checks">
            <label><input type="checkbox" /><span>QGIS abre en los equipos que se usarán durante la práctica.</span></label>
            <label><input type="checkbox" /><span>El CSV sintético está descargado y disponible en cada equipo.</span></label>
            <label><input type="checkbox" /><span>Hay una carpeta preparada para guardar el GeoJSON y el proyecto QGIS.</span></label>
            <label><input type="checkbox" /><span>La conexión permite mostrar el mapa base de OpenStreetMap.</span></label>
          </div>
          <aside class="guion-prep-aside">
            <h3>Material a mano</h3>
            <a href={href('/datos/')}><span class="icon-[tabler--database] size-5" aria-hidden="true"></span>Archivos del curso<span class="icon-[tabler--arrow-up-right] size-4" aria-hidden="true"></span></a>
            <a href={href(`/participante/${deck.slug}/`)}><span class="icon-[tabler--book] size-5" aria-hidden="true"></span>Guía del participante<span class="icon-[tabler--arrow-up-right] size-4" aria-hidden="true"></span></a>
            <p>Si falla la conexión, continúe con el GeoJSON y el CSV. Las teselas requieren red.</p>
          </aside>
        </div>
      </section>

      <section id="cronograma" class="guion-section">
        <div class="guion-section-heading">
          <h2>Ritmo de la sesión</h2>
          <p>Los minutos indican cuándo comienza cada diapositiva. Seleccione un título para ir a sus notas.</p>
        </div>
        <div class="guion-block-links print:hidden" aria-label="Ir a las notas de un bloque">
          {deck.blocks.map((block) => <a href={`#nota-bloque-${block.id.toLowerCase()}`}><strong>{/^\d/.test(block.id) ? `${block.id} · ` : ''}{block.label}</strong><span>{block.range}</span></a>)}
        </div>
        <div class="guion-table-wrap">
          <table class="guion-table">
            <thead><tr><th scope="col">Diap.</th><th scope="col">Hora</th><th scope="col">Tema</th><th scope="col">Bloque</th></tr></thead>
            <tbody>
              {deck.slides.map((s, i) => (
                <>
                  {(i === 0 || s.block !== deck.slides[i - 1].block) && <tr class="guion-table-block"><th colspan="4" scope="rowgroup">{blockLabel(s.block)}</th></tr>}
                  <tr><td class="guion-table-num">{i + 1}</td><td class="guion-table-time">{s.time}</td><td><a href={`#nota-${i + 1}`}>{s.title}</a></td><td class="guion-table-badge">{blockLabel(s.block)}</td></tr>
                </>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="notas" class="guion-section guion-notes-section">
        <div class="guion-section-heading">
          <h2>Notas por diapositiva</h2>
          <p>Vista de apoyo para explicar, comprobar y avanzar al ritmo del grupo.</p>
        </div>
        {deck.blocks.map((block) => {
          const slides = deck.slides.map((s, i) => ({ s, i })).filter(({ s }) => s.block === block.id)
          return (
            <section class="guion-note-block" id={`nota-bloque-${block.id.toLowerCase()}`}>
              <div class="guion-note-block-heading"><h3>{/^\d/.test(block.id) ? `${block.id} · ` : ''}{block.label}</h3><span>{block.range}</span></div>
              <ol class="guion-note-list">
                {slides.map(({ s, i }) => (
                  <li class="guion-note" id={`nota-${i + 1}`}>
                    <div class="guion-thumb" inert aria-hidden="true"><Slide slide={s} index={i} total={total} day={deck.day} /></div>
                    <div class="guion-note-copy">
                      <p class="guion-note-meta">Diapositiva {i + 1} de {total} <span>·</span> {s.time}</p>
                      <h4>{s.title}</h4>
                      <p>{s.notes}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )
        })}
      </section>
    </article>
  ) : (
  <article class="guion mx-auto max-w-5xl px-4 py-10 md:px-6">
    <header class="flex flex-wrap items-start justify-between gap-4 border-b border-base-content/10 pb-6">
      <div>
        <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-secondary">Guion del instructor · Día {deck.day} · {deck.schedule}</p>
        <h1 class="mt-2 text-3xl font-semibold text-balance">{deck.title}</h1>
        <p class="mt-3 max-w-3xl text-base-content/75">{deck.objective}</p>
      </div>
      <div class="flex gap-2 print:hidden">
        <a href={href(`/diapositivas/${deck.slug}/`)} class="btn btn-outline btn-sm"><span class="icon-[tabler--player-play] size-4"></span>Presentar</a>
        <button type="button" class="btn btn-primary btn-sm" onclick="window.print()"><span class="icon-[tabler--printer] size-4"></span>Imprimir</button>
      </div>
    </header>

    <section class="mt-8 grid gap-6 md:grid-cols-2 print:grid-cols-2">
      <div>
        <h2 class="text-lg font-semibold">Revisión antes de impartir</h2>
        <ul class="mt-3 space-y-2">
          {revision.map((r) => (
            <li class="flex items-start gap-2 text-sm"><span class="mt-0.5 inline-block size-4 shrink-0 rounded border border-base-content/40"></span>{r}</li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-lg font-semibold">Capturas pendientes ({capturas.length})</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {capturas.map(({ s, i }) => (
            <li class="flex gap-2"><span class="w-7 shrink-0 tabular-nums text-base-content/70">{i + 1}</span>{s.capture}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold">Distribución del tiempo</h2>
      <div class="mt-3 overflow-x-auto rounded-box border border-base-content/10">
        <table class="table table-sm">
          <thead><tr><th>#</th><th>Bloque</th><th>Minuto</th><th>Diapositiva</th></tr></thead>
          <tbody>
            {deck.slides.map((s, i) => (
              <tr><td class="tabular-nums">{i + 1}</td><td class="whitespace-nowrap">{blockLabel(s.block)}</td><td class="tabular-nums">{s.time}</td><td>{s.title}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10 break-before-page">
      <h2 class="text-lg font-semibold">Diapositivas y notas</h2>
      <ol class="mt-4 space-y-5">
        {deck.slides.map((s, i) => (
          <li class="guion-item grid gap-4 rounded-box border border-base-content/10 p-4 md:grid-cols-[320px_1fr] print:grid-cols-[260px_1fr]">
            <div class="guion-thumb overflow-hidden rounded-md border border-base-content/10">
              <Slide slide={s} index={i} total={total} day={deck.day} />
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-base-content/70">{i + 1} / {total} · {blockLabel(s.block)} · {s.time}</p>
              <h3 class="mt-1 font-display text-lg font-semibold">{s.title}</h3>
              <p class="mt-2 text-base-content/85">{s.notes}</p>
              {s.capture && <p class="mt-2 text-sm text-warning"><strong>Captura pendiente:</strong> {s.capture}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  </article>
  )}

  <style>
    .guion-thumb :global(.s-timer-actions) {
      display: none;
    }
    .guion--day2 {
      --guion-ink: #191b2d;
      --guion-muted: #51566b;
      --guion-line: #dfe1e9;
      --guion-red: #aa4545;
      color: var(--guion-ink);
    }
    .guion-cover {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 2rem;
      padding: clamp(1.75rem, 4vw, 3.5rem);
      border-radius: 1rem;
      background: #191b2d;
      color: #fff;
    }
    .guion-cover-copy {
      max-width: 47rem;
    }
    .guion-back {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      min-height: 2.5rem;
      margin-bottom: 1.2rem;
      color: #d8d9e4;
      font-size: 0.86rem;
      text-decoration: none;
      text-underline-offset: 0.2em;
    }
    .guion-back:hover {
      color: #fff;
      text-decoration: underline;
    }
    .guion-cover h1 {
      max-width: 16ch;
      font-size: clamp(2.2rem, 5vw, 4rem);
      font-weight: 600;
      letter-spacing: -0.025em;
      line-height: 1.08;
      text-wrap: balance;
    }
    .guion-session-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem 1.2rem;
      margin-top: 1.1rem;
      color: #e7d3d7;
      font-size: 0.9rem;
      font-variant-numeric: tabular-nums;
    }
    .guion-session-meta span + span::before {
      content: '·';
      margin-right: 1.2rem;
      color: #e08a8a;
    }
    .guion-cover-copy > p {
      max-width: 67ch;
      margin-top: 1.6rem;
      color: #e3e4ec;
      font-size: 1.04rem;
      line-height: 1.6;
    }
    .guion-cover-actions {
      display: flex;
      flex: none;
      flex-direction: column;
      gap: 0.6rem;
      min-width: 12.5rem;
    }
    .guion-cover-actions .btn {
      justify-content: flex-start;
      min-height: 2.9rem;
    }
    .guion-cover-actions .btn-outline {
      border-color: #b1b5c5;
      color: #fff;
    }
    .guion-cover-actions .btn-outline:hover {
      background: #30344a;
    }
    .guion-jump {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--guion-line);
    }
    .guion-jump a {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      min-height: 2.75rem;
      padding: 0.55rem 0.9rem;
      border-radius: 0.5rem;
      color: #30344a;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: background-color 160ms ease, color 160ms ease;
    }
    .guion-jump a:hover {
      background: #f5e9e9;
      color: #8a3434;
    }
    .guion-section {
      margin-top: clamp(2.5rem, 5vw, 4.5rem);
      scroll-margin-top: 7rem;
    }
    .guion-section-heading {
      margin-bottom: 1.5rem;
    }
    .guion-section-heading h2 {
      font-size: clamp(1.6rem, 3vw, 2.25rem);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.15;
    }
    .guion-section-heading p {
      max-width: 68ch;
      margin-top: 0.5rem;
      color: var(--guion-muted);
      line-height: 1.5;
    }
    .guion-prep-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) minmax(250px, 0.85fr);
      gap: clamp(1.2rem, 3vw, 2.5rem);
      align-items: start;
    }
    .guion-prep-checks {
      border-top: 1px solid var(--guion-line);
    }
    .guion-prep-checks label {
      display: flex;
      align-items: flex-start;
      gap: 0.9rem;
      padding: 1rem 0.3rem;
      border-bottom: 1px solid var(--guion-line);
      font-size: 1.02rem;
      line-height: 1.45;
      cursor: pointer;
    }
    .guion-prep-checks label:hover {
      background: #f7f7f9;
    }
    .guion-prep-checks input {
      flex: none;
      width: 1.25rem;
      height: 1.25rem;
      margin-top: 0.12rem;
      accent-color: var(--guion-red);
      cursor: pointer;
    }
    .guion-prep-checks input:focus-visible {
      outline: 3px solid var(--guion-red);
      outline-offset: 3px;
    }
    .guion-prep-aside {
      padding: 1.4rem;
      border-radius: 0.8rem;
      background: #f1f1f5;
    }
    .guion-prep-aside h3 {
      margin-bottom: 0.7rem;
      font-size: 1.12rem;
      font-weight: 600;
    }
    .guion-prep-aside a {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      min-height: 2.7rem;
      padding: 0.45rem 0;
      color: #6c2727;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
    .guion-prep-aside a:hover {
      color: #191b2d;
    }
    .guion-prep-aside a span:last-child {
      margin-left: auto;
    }
    .guion-prep-aside p {
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px solid #cfd2dd;
      color: #4c5267;
      font-size: 0.9rem;
      line-height: 1.5;
    }
    .guion-block-links {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      margin-bottom: 1.25rem;
      padding-bottom: 0.4rem;
      scrollbar-color: #9b9eac transparent;
      scrollbar-width: thin;
    }
    .guion-block-links a {
      display: flex;
      flex: none;
      flex-direction: column;
      gap: 0.2rem;
      max-width: 13rem;
      min-width: 9rem;
      min-height: 4.2rem;
      padding: 0.8rem 0.9rem;
      border: 1px solid var(--guion-line);
      border-radius: 0.65rem;
      color: var(--guion-ink);
      font-size: 0.82rem;
      line-height: 1.25;
      text-decoration: none;
      transition: border-color 160ms ease, background-color 160ms ease;
    }
    .guion-block-links a:hover {
      border-color: #b85d5d;
      background: #fcf6f6;
    }
    .guion-block-links span {
      margin-top: auto;
      color: var(--guion-muted);
      font-size: 0.76rem;
      font-variant-numeric: tabular-nums;
    }
    .guion-table-wrap {
      overflow-x: auto;
      border: 1px solid var(--guion-line);
      border-radius: 0.75rem;
    }
    .guion-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.94rem;
      line-height: 1.35;
    }
    .guion-table thead {
      background: #191b2d;
      color: #fff;
      text-align: left;
    }
    .guion-table thead th {
      padding: 0.85rem 1rem;
      font-family: 'Lexend', sans-serif;
      font-size: 0.76rem;
      font-weight: 500;
    }
    .guion-table tbody td {
      padding: 0.65rem 1rem;
      border-top: 1px solid #e6e7ed;
      vertical-align: top;
    }
    .guion-table tbody tr:hover:not(.guion-table-block) {
      background: #f8f6f6;
    }
    .guion-table-block th {
      padding: 0.75rem 1rem 0.5rem;
      border-top: 1px solid #d1d4df;
      background: #f0f1f5;
      color: #30344a;
      font-family: 'Lexend', sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      text-align: left;
    }
    .guion-table-num,
    .guion-table-time {
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .guion-table-num {
      color: #6c2727;
      font-family: 'Lexend', sans-serif;
      font-weight: 600;
    }
    .guion-table a {
      color: #243e65;
      font-weight: 600;
      text-decoration: underline;
      text-decoration-color: #a9b4c7;
      text-underline-offset: 0.2em;
    }
    .guion-table a:hover {
      color: #8a3434;
    }
    .guion-table-badge {
      color: var(--guion-muted);
      font-size: 0.82rem;
    }
    .guion-note-block {
      margin-top: 2.25rem;
      scroll-margin-top: 6rem;
    }
    .guion-note-block-heading {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: 0.8rem;
      border-bottom: 1px solid #bfc3d1;
    }
    .guion-note-block-heading h3 {
      font-size: 1.25rem;
      font-weight: 600;
    }
    .guion-note-block-heading span {
      color: var(--guion-muted);
      font-size: 0.85rem;
      font-variant-numeric: tabular-nums;
    }
    .guion-note-list {
      list-style: none;
    }
    .guion-note {
      display: grid;
      grid-template-columns: minmax(220px, 300px) minmax(0, 1fr);
      gap: clamp(1rem, 3vw, 2rem);
      align-items: start;
      padding: 1.35rem 0;
      border-bottom: 1px solid var(--guion-line);
      scroll-margin-top: 6rem;
    }
    .guion--day2 .guion-thumb {
      overflow: hidden;
      width: 100%;
      border-radius: 0.45rem;
      box-shadow: 0 9px 24px rgb(25 27 45 / 0.11);
    }
    .guion-note-meta {
      color: #6c2727;
      font-size: 0.78rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }
    .guion-note-meta span {
      margin: 0 0.3rem;
      color: #8b90a0;
    }
    .guion-note-copy h4 {
      margin-top: 0.35rem;
      font-size: 1.18rem;
      font-weight: 600;
      line-height: 1.3;
    }
    .guion-note-copy > p:last-child {
      max-width: 70ch;
      margin-top: 0.8rem;
      color: #34394c;
      font-size: 1rem;
      line-height: 1.58;
    }
    @media (max-width: 800px) {
      .guion-cover {
        align-items: stretch;
        flex-direction: column;
      }
      .guion-cover-actions {
        flex-direction: row;
      }
      .guion-prep-grid {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 600px) {
      .guion-cover-actions {
        flex-direction: column;
      }
      .guion-session-meta span + span::before {
        margin-right: 0.5rem;
      }
      .guion-note {
        grid-template-columns: 1fr;
      }
      .guion--day2 .guion-thumb {
        max-width: 28rem;
      }
      .guion-table thead th:last-child,
      .guion-table-badge {
        display: none;
      }
      .guion-table thead th,
      .guion-table tbody td,
      .guion-table-block th {
        padding-right: 0.65rem;
        padding-left: 0.65rem;
      }
    }
    @media print {
      @page {
        size: letter;
        margin: 1.2cm;
      }
      .guion-item {
        break-inside: avoid;
      }
      .guion :global(.slide) {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        break-after: auto;
      }
      .guion--day2 {
        max-width: none;
        padding: 0;
      }
      .guion--day2 .guion-cover {
        display: block;
        padding: 0 0 1.2rem;
        border-bottom: 2px solid #191b2d;
        border-radius: 0;
        background: #fff;
        color: #191b2d;
      }
      .guion--day2 .guion-cover h1 {
        font-size: 2rem;
      }
      .guion--day2 .guion-session-meta {
        color: #4c5267;
      }
      .guion--day2 .guion-cover-copy > p {
        margin-top: 0.6rem;
        color: #30344a;
        font-size: 0.88rem;
