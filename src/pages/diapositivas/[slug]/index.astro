---
import '../../../styles/global.css'
import '../../../styles/slides.css'
import Slide from '../../../components/slides/Slide.astro'
import Head from '../../../components/Head.astro'
import { decksAbiertos } from '../../../data/decks'
import type { Deck } from '../../../data/types'
import { absoluteUrl, href, qrSvg } from '../../../lib/site'
import { materialesDe } from '../../../data/materiales'

export function getStaticPaths() {
  return decksAbiertos.map((deck) => ({ params: { slug: deck.slug }, props: { deck } }))
}

const { deck } = Astro.props as { deck: Deck }
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const total = deck.slides.length
const notes = deck.slides.map((s) => s.notes)
const blockLabels = Object.fromEntries(deck.blocks.map((b) => [b.id, b.label]))
const participantUrl = absoluteUrl(`/participante/${deck.slug}/`)
const qr = await qrSvg(participantUrl)
const material = materialesDe(deck.slides)
const general = [
  { label: 'Material del participante', texto: 'Objetivos, pasos y lista de revisión del día.', path: `/participante/${deck.slug}/`, icon: 'icon-[tabler--book]' },
  { label: 'Resumen imprimible', texto: 'Una página con lo esencial del día.', path: `/participante/${deck.slug}/resumen/`, icon: 'icon-[tabler--printer]' },
  { label: 'Práctica', texto: 'Todas las actividades del curso.', path: '/practica/', icon: 'icon-[tabler--pencil]' },
]
---

<!doctype html>
<html lang="es-MX" data-theme="karsam">
  <head>
    <Head title={`Día ${deck.day} · Diapositivas`} />
  </head>
  <body class="deck-body" data-day={deck.day}>
    <div class="deck-wrap">
      <p class="deck-mobile-note" role="note">
        {deck.day === 2 ? 'Para seguir los pasos de QGIS en el celular, abra la guía del día. ' : 'Las diapositivas están hechas para proyectar. En el celular lea mejor el '}
        <a href={`${base}/participante/${deck.slug}/`}>{deck.day === 2 ? 'Abrir guía del Día 2' : 'material del participante'}</a>{deck.day === 2 ? '' : '.'}
      </p>
      <div class="deck-stage" data-deck={deck.slug} tabindex="-1">
        {deck.slides.map((slide, i) => <Slide slide={slide} index={i} total={total} day={deck.day} qr={qr} qrUrl={participantUrl} />)}
      </div>
    </div>
    <p class="sr-only" aria-live="polite" data-live></p>

    <aside class="deck-notes no-print" data-notes-panel hidden>
      <div class="mx-auto flex max-w-5xl gap-3">
        <span class="icon-[tabler--notes] mt-0.5 size-5 shrink-0 text-rojo-claro"></span>
        <p data-notes-text></p>
      </div>
    </aside>

    <nav class="deck-bar no-print" aria-label="Controles de la presentación">
      <div class="progress deck-progress" role="progressbar" aria-label="Avance" aria-valuemin="1" aria-valuemax={total}>
        <div class="progress-bar progress-secondary" data-progress style="width: 0%"></div>
      </div>
      <div class="deck-bar-row">
        <a href={`${base}/diapositivas/`} class="btn btn-text btn-square btn-sm" aria-label="Volver al índice de presentaciones" title="Volver">
          <span class="icon-[tabler--arrow-left] size-5"></span>
        </a>
        <button type="button" class="btn btn-text btn-sm" aria-haspopup="dialog" aria-expanded="false" aria-controls="deck-index" data-overlay="#deck-index" title="Índice (G)">
          <span class="icon-[tabler--list-numbers] size-5"></span><span class="max-sm:hidden">Índice</span>
        </button>
        <button type="button" class="btn btn-text btn-sm" aria-haspopup="dialog" aria-expanded="false" aria-controls="deck-material" data-overlay="#deck-material" title="Material del día">
          <span class="icon-[tabler--books] size-5"></span><span class="max-sm:hidden">Material</span>
        </button>
        <button type="button" class="btn btn-text btn-sm" data-open-grid title="Vista de miniaturas (Esc u O)">
          <span class="icon-[tabler--layout-grid] size-5"></span><span class="max-lg:hidden">Miniaturas</span>
        </button>
        <span class="badge badge-soft badge-secondary max-md:hidden" data-block-badge></span>

        <div class="mx-auto flex items-center gap-1">
          <button type="button" class="btn btn-text btn-square btn-sm" data-prev aria-label="Anterior" title="Anterior (←)">
            <span class="icon-[tabler--chevron-left] size-5"></span>
          </button>
          <span class="min-w-16 text-center text-sm tabular-nums" data-counter>1 / {total}</span>
          <button type="button" class="btn btn-text btn-square btn-sm" data-next aria-label="Siguiente" title="Siguiente (→)">
            <span class="icon-[tabler--chevron-right] size-5"></span>
          </button>
        </div>

        <button type="button" class="btn btn-text btn-square btn-sm" data-toggle-reveal aria-pressed="true" aria-label="Revelar viñetas una por una" title="Viñetas una por una (R)">
          <span class="icon-[tabler--list-details] size-5"></span>
        </button>
        <button type="button" class="btn btn-text btn-square btn-sm" data-mode-btn="large" aria-pressed="false" aria-label="Texto grande" title="Texto grande (L)">
          <span class="icon-[tabler--text-size] size-5" aria-hidden="true"></span>
        </button>
        <button type="button" class="btn btn-text btn-square btn-sm" data-mode-btn="contrast" aria-pressed="false" aria-label="Alto contraste" title="Alto contraste (C)">
          <span class="icon-[tabler--contrast-2] size-5" aria-hidden="true"></span>
        </button>
        <button type="button" class="btn btn-text btn-square btn-sm" data-toggle-notes aria-pressed="false" aria-label="Notas del instructor" title="Notas (N)">
          <span class="icon-[tabler--notes] size-5"></span>
        </button>
        <a href={`${base}/diapositivas/${deck.slug}/presentador/`} target="deck-presentador" class="btn btn-text btn-square btn-sm" data-presenter aria-label="Abrir vista del presentador" title="Vista del presentador (P)">
          <span class="icon-[tabler--device-desktop-analytics] size-5"></span>
        </a>
        <a href={`${base}/diapositivas/${deck.slug}/guion/`} class="btn btn-text btn-square btn-sm max-sm:hidden" aria-label="Guion del instructor para imprimir" title="Guion del instructor">
          <span class="icon-[tabler--script] size-5"></span>
        </a>
        <button type="button" class="btn btn-text btn-square btn-sm max-sm:hidden" data-print aria-label="Imprimir o guardar en PDF" title="Imprimir / PDF">
          <span class="icon-[tabler--printer] size-5"></span>
        </button>
        <button type="button" class="btn btn-text btn-square btn-sm" data-fullscreen aria-label="Pantalla completa" title="Pantalla completa (F)">
          <span class="icon-[tabler--maximize] size-5"></span>
        </button>
        <button type="button" class="btn btn-text btn-square btn-sm" aria-haspopup="dialog" aria-expanded="false" aria-controls="deck-help" data-overlay="#deck-help" aria-label="Atajos de teclado" title="Atajos (?)">
          <span class="icon-[tabler--keyboard] size-5"></span>
        </button>
      </div>
    </nav>

    <!-- Índice de diapositivas con bloque y minuto estimado -->
    <div id="deck-index" class="overlay overlay-open:translate-x-0 drawer drawer-start hidden max-w-md no-print" role="dialog" tabindex="-1" aria-labelledby="deck-index-title">
      <div class="drawer-header">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-secondary">Día {deck.day} · {deck.schedule}</p>
          <h3 id="deck-index-title" class="drawer-title">{deck.title}</h3>
        </div>
        <button type="button" class="btn btn-text btn-circle btn-sm absolute end-3 top-3" aria-label="Cerrar" data-overlay="#deck-index">
          <span class="icon-[tabler--x] size-5"></span>
        </button>
      </div>
      <div class="drawer-body">
        {deck.blocks.map((block) => {
          const items = deck.slides.map((s, i) => ({ s, i })).filter(({ s }) => s.block === block.id)
          return (
            <section class="mb-4">
              <h4 class="mb-1 flex items-baseline justify-between gap-2 text-sm font-semibold">
                <span>{/^\d/.test(block.id) ? `${block.id} · ` : ''}{block.label}</span>
                <span class="text-xs font-normal text-base-content/70">{block.range}</span>
              </h4>
              <ul class="menu p-0">
                {items.map(({ s, i }) => (
                  <li>
                    <a href={`#${i + 1}`} data-goto={i} class="items-start gap-3 py-1.5">
                      <span class="w-6 shrink-0 text-end text-xs tabular-nums text-base-content/70">{i + 1}</span>
                      <span class="flex-1 text-sm leading-snug">{s.title}</span>
                      <span class="shrink-0 text-xs tabular-nums text-base-content/70">{s.time}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        })}
      </div>
    </div>

    <!-- Material del sitio que acompaña al día, con la diapositiva donde se usa -->
    <div id="deck-material" class="overlay overlay-open:translate-x-0 drawer drawer-end hidden max-w-md no-print" role="dialog" tabindex="-1" aria-labelledby="deck-material-title">
      <div class="drawer-header">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-secondary">Día {deck.day} · Material</p>
          <h3 id="deck-material-title" class="drawer-title">Lo que acompaña a estas diapositivas</h3>
        </div>
        <button type="button" class="btn btn-text btn-circle btn-sm absolute end-3 top-3" aria-label="Cerrar" data-overlay="#deck-material">
          <span class="icon-[tabler--x] size-5"></span>
        </button>
      </div>
      <div class="drawer-body">
        <h4 class="mb-2 text-sm font-semibold">Para el participante</h4>
        <ul class="mb-5 space-y-2">
          {general.map((m) => (
            <li>
              <a href={href(m.path)} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-box border border-base-content/10 p-3 hover:border-secondary">
                <span class={`${m.icon} size-6 shrink-0 text-secondary`}></span>
                <span class="flex-1"><strong class="block text-sm">{m.label}</strong><span class="text-xs text-base-content/70">{m.texto}</span></span>
                <span class="icon-[tabler--external-link] size-4 text-base-content/50"></span>
              </a>
            </li>
          ))}
        </ul>
        <h4 class="mb-2 text-sm font-semibold">En el transcurso del día</h4>
        <ul class="space-y-2">
          {material.map((m) => (
            <li class="flex items-center gap-2 rounded-box border border-base-content/10 p-2 ps-3">
              <span class={`${m.icon} size-5 shrink-0 text-secondary`}></span>
              <a href={href(m.path)} target="_blank" rel="noopener" class="link link-hover flex-1 text-sm font-medium">{m.label}</a>
              <a href={`#${m.slide + 1}`} data-goto={m.slide} class="btn btn-text btn-xs tabular-nums" title={deck.slides[m.slide].title}>
                Diap. {m.slide + 1} · {deck.slides[m.slide].time}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Atajos -->
    <div id="deck-help" class="overlay modal overlay-open:opacity-100 hidden no-print" role="dialog" tabindex="-1" aria-labelledby="deck-help-title">
      <div class="modal-dialog overlay-open:opacity-100">
        <div class="modal-content">
          <div class="modal-header">
            <h3 id="deck-help-title" class="modal-title">Atajos de teclado</h3>
            <button type="button" class="btn btn-text btn-circle btn-sm absolute end-3 top-3" aria-label="Cerrar" data-overlay="#deck-help">
              <span class="icon-[tabler--x] size-5"></span>
            </button>
          </div>
          <div class="modal-body">
            <table class="table table-sm">
              <tbody>
                <tr><td><kbd class="kbd kbd-sm">→</kbd> <kbd class="kbd kbd-sm">Espacio</kbd> <kbd class="kbd kbd-sm">AvPág</kbd></td><td>Siguiente</td></tr>
                <tr><td><kbd class="kbd kbd-sm">←</kbd> <kbd class="kbd kbd-sm">RePág</kbd></td><td>Anterior</td></tr>
                <tr><td><kbd class="kbd kbd-sm">Inicio</kbd> <kbd class="kbd kbd-sm">Fin</kbd></td><td>Primera / última</td></tr>
                <tr><td><kbd class="kbd kbd-sm">Esc</kbd> <kbd class="kbd kbd-sm">O</kbd></td><td>Miniaturas de todas las diapositivas</td></tr>
                <tr><td><kbd class="kbd kbd-sm">G</kbd></td><td>Índice con tiempos</td></tr>
                <tr><td><kbd class="kbd kbd-sm">R</kbd></td><td>Viñetas una por una, o todas a la vez</td></tr>
                <tr><td><kbd class="kbd kbd-sm">N</kbd></td><td>Mostrar u ocultar notas</td></tr>
                <tr><td><kbd class="kbd kbd-sm">P</kbd></td><td>Vista del presentador (otra ventana)</td></tr>
                <tr><td><kbd class="kbd kbd-sm">F</kbd></td><td>Pantalla completa</td></tr>
                <tr><td><kbd class="kbd kbd-sm">B</kbd></td><td>Pantalla en negro</td></tr>
                <tr><td><kbd class="kbd kbd-sm">L</kbd></td><td>Texto grande (para salones amplios)</td></tr>
                <tr><td><kbd class="kbd kbd-sm">C</kbd></td><td>Alto contraste (proyectores con poca luz)</td></tr>
                <tr><td><kbd class="kbd kbd-sm">T</kbd></td><td>Iniciar o pausar el cronómetro</td></tr>
              </tbody>
            </table>
            <p class="mt-3 text-sm text-base-content/70">Los controles remotos de presentación funcionan como flechas o AvPág/RePág.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="deck-blackout" data-blackout hidden></div>

    <!-- Miniaturas -->
    <div class="deck-grid no-print" data-grid hidden role="dialog" aria-modal="true" aria-labelledby="deck-grid-title">
      <div class="deck-grid-head">
        <h2 id="deck-grid-title" class="font-display text-lg font-semibold">Día {deck.day} · {total} diapositivas</h2>
        <button type="button" class="btn btn-text btn-sm text-white" data-close-grid>
          <span class="icon-[tabler--x] size-5"></span>Cerrar <kbd class="kbd kbd-sm ms-1">Esc</kbd>
        </button>
      </div>
      <div class="deck-grid-list" data-grid-list></div>
    </div>

    <script type="application/json" id="deck-data" set:html={JSON.stringify({ notes, blockLabels })}></script>

    <script>
      import 'flyonui/flyonui'
      import { initDeck } from '../../../scripts/deck'
      initDeck()
    </script>

    <style is:global>
      .deck-body {
        height: 100dvh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: #0e0f1c;
        color: #e8e8f0;
      }
      .deck-wrap {
        flex: 1;
        min-height: 0;
        container-type: size;
        display: grid;
        place-items: center;
        padding: 0.75rem;
      }
      .deck-stage {
        width: min(100cqw, calc(100cqh * 16 / 9));
        box-shadow: 0 20px 60px rgb(0 0 0 / 0.45);
      }
      .deck-stage .slide:not(.is-active) {
        display: none;
      }
      .deck-stage .slide.is-active {
        animation: deck-in 180ms ease-out;
      }
      @keyframes deck-in {
        from {
          opacity: 0.4;
        }
      }
      .deck-notes {
        max-height: 30dvh;
        overflow: auto;
        padding: 0.9rem 1.25rem;
        background: #191b2d;
        border-top: 1px solid #2c2f49;
        font-size: 1.05rem;
        line-height: 1.5;
      }
      .deck-bar {
        background: #14152a;
        border-top: 1px solid #23253d;
        transition: opacity 200ms;
      }
      .deck-bar .btn-text,
      .deck-bar [data-counter] {
        color: #d9d9e6;
      }
      .deck-bar-row {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.35rem 0.75rem;
        /* En pantallas angostas la barra se desplaza en lugar de recortar botones */
        overflow-x: auto;
        scrollbar-width: thin;
      }
      .deck-bar-row > * {
        flex-shrink: 0;
      }
      .deck-progress {
        height: 3px;
        border-radius: 0;
        background: #23253d;
      }
      .deck-progress .progress-bar {
        border-radius: 0;
        transition: width 200ms;
      }
      .deck-grid {
        position: fixed;
        inset: 0;
        z-index: 90;
        overflow: auto;
        background: #0e0f1c;
        color: #fff;
      }
      .deck-grid-head {
        position: sticky;
        top: 0;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.9rem 1.25rem;
        background: #0e0f1c;
        border-bottom: 1px solid #23253d;
      }
      .deck-grid-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.1rem;
        padding: 1.25rem;
      }
      .deck-thumb {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        text-align: start;
        border-radius: 0.5rem;
        outline-offset: 4px;
        cursor: pointer;
      }
      .deck-thumb .slide {
        border-radius: 0.375rem;
        transition: transform 150ms;
      }
      .deck-thumb:hover .slide {
        transform: translateY(-2px);
      }
      .deck-thumb[aria-current='true'] .slide {
        outline: 3px solid #aa4545;
        outline-offset: 2px;
      }
      .deck-thumb-num {
        font-size: 0.8rem;
        color: #a9abbd;
        font-variant-numeric: tabular-nums;
      }
      .deck-stage:focus-visible {
        outline: 3px solid #e08a8a;
        outline-offset: 4px;
      }
      @media (prefers-reduced-motion: reduce) {
        .deck-stage .slide.is-active {
          animation: none;
        }
      }
      .deck-blackout {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: #000;
      }
      body.is-fullscreen .deck-wrap {
        padding: 0;
      }
      body.is-fullscreen .deck-stage {
        box-shadow: none;
      }
      body.is-fullscreen .deck-bar {
        position: fixed;
        inset: auto 0 0 0;
        opacity: 0;
      }
      body.is-fullscreen .deck-bar:hover,
      body.is-fullscreen .deck-bar:focus-within {
        opacity: 1;
      }
      #deck-index,
      #deck-material,
      #deck-help {
        color: var(--color-base-content);
      }
      @media print {
        @page {
          size: 13.333in 7.5in;
          margin: 0;
        }
        .deck-stage .slide {
          break-after: page;
        }
        .deck-body {
          display: block;
          height: auto;
          overflow: visible;
          background: #fff;
        }
        .deck-wrap {
          display: block;
          padding: 0;
          container-type: normal;
        }
        .deck-stage {
          width: 100%;
          box-shadow: none;
        }
        .deck-stage .slide:not(.is-active) {
          display: block;
        }
        .deck-stage .slide.is-active {
          animation: none;
        }
      }
          .deck-mobile-note {
        display: none;
        padding: 0.6rem 1rem;
        background: #b7791f;
        color: #fff;
        font-size: 0.95rem;
      }
      .deck-mobile-note a {
        color: #fff;
        font-weight: 700;
        text-decoration: underline;
      }
      @media (max-width: 700px) {
        .deck-mobile-note {
          display: block;
        }
      }
      .deck-body[data-day='2'] {
        background: #0d1b2b;
        color: #e5efef;
      }
      .deck-body[data-day='2'] .deck-stage {
        box-shadow: 0 1.5rem 4rem rgb(1 12 20 / 0.55);
      }
      .deck-body[data-day='2'] .deck-bar {
        background: #12283b;
        border-top-color: #34504f;
      }
      .deck-body[data-day='2'] .deck-bar-row {
        gap: 0.3rem;
        padding: 0.5rem 0.9rem;
        scrollbar-color: #638d81 #12283b;
      }
      .deck-body[data-day='2'] .deck-bar-row .btn-sm {
        min-height: 2.5rem;
        border-radius: 0.6rem;
      }
      .deck-body[data-day='2'] .deck-bar .btn-text,
      .deck-body[data-day='2'] .deck-bar [data-counter] {
        color: #edf5f3;
      }
      .deck-body[data-day='2'] .deck-bar .btn-text:hover,
      .deck-body[data-day='2'] .deck-bar .btn-text[aria-pressed='true'] {
        background: #2a514c;
        color: #fff;
      }
      .deck-body[data-day='2'] .deck-bar .btn-text:focus-visible,
      .deck-body[data-day='2'] .deck-thumb:focus-visible {
        outline: 2px solid #a8dfc9;
        outline-offset: 2px;
      }
      .deck-body[data-day='2'] .deck-progress {
        height: 4px;
        background: #294443;
      }
      .deck-body[data-day='2'] .deck-progress .progress-bar {
        background: #9cdbc0;
      }
      .deck-body[data-day='2'] .deck-notes {
        background: #1c3a48;
        border-top-color: #42605e;
      }
      .deck-body[data-day='2'] .deck-grid {
        background: #0d1b2b;
      }
      .deck-body[data-day='2'] .deck-grid-head {
        background: #102337;
        border-bottom-color: #34504f;
      }
      .deck-body[data-day='2'] .deck-thumb[aria-current='true'] .slide {
        outline-color: #9cdbc0;
      }
      .deck-body[data-day='2'] .deck-mobile-note {
        background: #1c3a48;
        color: #f0f6f2;
      }
      .deck-body[data-day='2'] .deck-mobile-note a {
        color: #fff;
        text-underline-offset: 3px;
      }
      @media (max-width: 700px) {
        .deck-body[data-day='2'] .deck-wrap {
          display: flex;
          flex-direction: column;
          align-items: stretch;
          justify-content: flex-start;
          gap: 1rem;
          padding: 1rem 0.75rem;
        }
        .deck-body[data-day='2'] .deck-mobile-note {
          margin: 0;
          border-radius: 0.75rem;
          padding: 0.9rem 1rem;
          line-height: 1.45;
        }
        .deck-body[data-day='2'] .deck-stage {
          width: 100%;
        }
      }
      .deck-body[data-day='2'] ::selection {
        background: #9cdbc0;
        color: #102337;
      }
      @media print {
        .deck-body[data-day='2'] .deck-stage {
          box-shadow: none;
        }
      }
    </style>
  </body>
</html>
