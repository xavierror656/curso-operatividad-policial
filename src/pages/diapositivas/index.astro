---
import Layout from '../../layouts/Layout.astro'
import { sesiones } from '../../data/curso'
import { getDeck } from '../../data/decks'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Layout title="Diapositivas · Operatividad policial">
  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-secondary">Material de apoyo</p>
    <h1 class="mt-3 text-4xl font-semibold">Diapositivas por sesión</h1>
    <p class="mt-3 max-w-3xl text-base-content/70">
      Cada presentación funciona en el navegador, sin conexión una vez cargada. Use la vista del presentador en su pantalla y la de diapositivas en el proyector: se mantienen sincronizadas.
    </p>

    <div class="mt-10 grid gap-6">
      {sesiones.map((s) => {
        const deck = getDeck(s.slug)
        return (
          <article class="card card-side border border-base-content/10 shadow-none max-md:flex-col">
            <div class="grid place-items-center bg-primary p-8 text-primary-content md:w-56">
              <div class="text-center">
                <div class="text-xs uppercase tracking-widest text-primary-content/60">Día</div>
                <div class="font-display text-6xl font-bold">{s.dia}</div>
              </div>
            </div>
            <div class="card-body gap-3">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="card-title font-display text-xl">{s.titulo}</h2>
                {deck ? <span class="badge badge-soft badge-success">{deck.slides.length} diapositivas</span> : <span class="badge badge-soft">En preparación</span>}
              </div>
              {deck && <p class="text-base-content/70">{deck.objective}</p>}
              <p class="text-sm"><strong>Entregable:</strong> {s.entregable}</p>
              <div class="card-actions mt-2">
                {deck ? (
                  <>
                    <a href={`${base}/diapositivas/${deck.slug}/`} class="btn btn-primary"><span class="icon-[tabler--player-play] size-5"></span>Presentar</a>
                    <a href={`${base}/diapositivas/${deck.slug}/presentador/`} class="btn btn-outline btn-secondary"><span class="icon-[tabler--device-desktop-analytics] size-5"></span>Vista del presentador</a>
                    <a href={`${base}/diapositivas/${deck.slug}/guion/`} class="btn btn-outline"><span class="icon-[tabler--script] size-5"></span>Guion para imprimir</a>
                    <a href={`${base}/participante/${deck.slug}/`} class="btn btn-outline"><span class="icon-[tabler--device-mobile] size-5"></span>Participante</a>
                  </>
                ) : (
                  <button class="btn" disabled>Próximamente</button>
                )}
              </div>
            </div>
          </article>
        )
      })}
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      <div class="alert alert-soft items-start">
        <span class="icon-[tabler--keyboard] size-5 shrink-0"></span>
        <p><strong>Teclado o control remoto.</strong> Flechas y AvPág/RePág avanzan viñeta por viñeta. <kbd class="kbd kbd-sm">Esc</kbd> miniaturas, <kbd class="kbd kbd-sm">N</kbd> notas, <kbd class="kbd kbd-sm">R</kbd> todas las viñetas, <kbd class="kbd kbd-sm">F</kbd> pantalla completa.</p>
      </div>
      <div class="alert alert-soft items-start">
        <span class="icon-[tabler--printer] size-5 shrink-0"></span>
        <p><strong>Funciona sin internet.</strong> Abra el sitio una vez con conexión y queda guardado en el navegador. De respaldo, imprima en PDF.</p>
      </div>
      <div class="alert alert-soft alert-warning items-start">
        <span class="icon-[tabler--photo-plus] size-5 shrink-0"></span>
        <p><strong>Capturas pendientes.</strong> Los recuadros «[CAPTURA]» se sustituyen por pantallas reales de la plataforma antes de impartir.</p>
      </div>
    </div>
  </section>
</Layout>
