---
import Layout from '../../layouts/Layout.astro'
import Dia2Participante from '../../components/Dia2Participante.astro'
import ReglaDeOro from '../../components/ReglaDeOro.astro'
import { abierto, decks, decksAbiertos } from '../../data/decks'
import type { Deck } from '../../data/types'
import { href } from '../../lib/site'
import { materialesDe } from '../../data/materiales'

export function getStaticPaths() {
  return decksAbiertos.map((deck) => ({ params: { slug: deck.slug }, props: { deck } }))
}

// Versión para el participante: lo que necesita a la mano, sin notas del instructor
const { deck } = Astro.props as { deck: Deck }
const logro = deck.slides.find((s) => s.kicker === 'Qué se logra hoy')
const entregable = deck.slides.find((s) => s.kicker === 'Entregable del día')
const taller = deck.slides.find((s) => s.layout === 'checklist' && /se revisa|cada presentación/i.test(s.title))
const flujos = deck.slides.filter((s) => s.layout === 'flow' && !s.kicker?.startsWith('Puente'))
const llevas = deck.slides.filter((s) => s.layout === 'takeaway')
const otros = decksAbiertos.filter((d) => d.slug !== deck.slug)
const material = materialesDe(deck.slides)
const usaIA = deck.slides.some((s) => s.ruleReminder)
const momento = (i: number) => {
  const s = deck.slides[i]
  const bloque = deck.blocks.find((b) => b.id === s.block)
  return `${/^\d/.test(s.block) ? `Bloque ${s.block}` : bloque?.label ?? s.block} · ${s.time}`
}
---

<Layout title={`Día ${deck.day} · Material del participante`} description={`Material del participante del Día ${deck.day}: ${deck.title}.`}>
  {deck.day === 2 && <Dia2Participante deck={deck} />}
  {deck.day !== 2 && (
  <article class="mx-auto max-w-3xl px-4 py-8 md:py-12">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-secondary">Día {deck.day} · {deck.schedule}</p>
    <h1 class="mt-2 text-3xl font-semibold text-balance md:text-4xl">{deck.title}</h1>
    <p class="mt-3 text-base-content/75">{deck.objective}</p>

    <nav class="mt-6 flex flex-wrap gap-2" aria-label="Días del curso">
      {decks.map((d) => abierto(d.slug) ? (
        <a href={href(`/participante/${d.slug}/`)} class:list={['btn btn-sm', d.slug === deck.slug ? 'btn-primary' : 'btn-outline']} aria-current={d.slug === deck.slug ? 'page' : undefined}>Día {d.day}</a>
      ) : (
        <span class="btn btn-sm btn-disabled" title={`Se abre el Día ${d.day}`}><span class="icon-[tabler--lock] size-4" aria-hidden="true"></span>Día {d.day}</span>
      ))}
    </nav>

    {deck.day > 1 && <a href={href(`/cuestionario/dia-${deck.day}/`)} class="btn btn-outline btn-sm mt-4"><span class="icon-[tabler--checklist] size-4"></span>Contestar el cuestionario del Día {deck.day}</a>}

    {usaIA && <div class="mt-8"><ReglaDeOro compact /></div>}

    {logro && (
      <section class="mt-10">
        <h2 class="text-xl font-semibold">{logro.title}</h2>
        <ul class="mt-4 space-y-3">
          {logro.bullets?.map((b) => <li class="flex gap-3"><span class="icon-[tabler--target-arrow] mt-0.5 size-5 shrink-0 text-secondary"></span>{b}</li>)}
        </ul>
      </section>
    )}

    {flujos.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xl font-semibold">Pasos del día</h2>
        <div class="mt-4 space-y-4">
          {flujos.map((f) => (
            <div class="card border border-base-content/10 shadow-none">
              <div class="card-body gap-3 p-5">
                <h3 class="font-display font-semibold">{f.title}</h3>
                <ol class="space-y-2">
                  {f.steps?.map((st, i) => (
                    <li class="flex gap-3">
                      <span class="grid size-7 shrink-0 place-items-center rounded-full bg-primary text-sm font-semibold text-primary-content">{i + 1}</span>
                      <span><strong>{st.label}</strong>{st.detail && <span class="text-base-content/70"> · {st.detail}</span>}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {taller && (
      <section class="mt-10">
        <h2 class="text-xl font-semibold">{taller.title}</h2>
        <ul class="mt-4 space-y-2" data-checklist={`taller-${deck.slug}`}>
          {taller.bullets?.map((b, i) => (
            <li>
              <label class="flex cursor-pointer items-start gap-3 rounded-box p-2 hover:bg-base-200">
                <input type="checkbox" class="checkbox checkbox-secondary mt-0.5" data-check={i} />
                <span>{b}</span>
              </label>
            </li>
          ))}
        </ul>
        <p class="mt-2 text-sm text-base-content/70">Las marcas se guardan solo en este dispositivo.</p>
      </section>
    )}

    {entregable && (
      <section class="mt-10">
        <h2 class="text-xl font-semibold">{entregable.title}</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {entregable.cards?.map((c) => (
            <div class="alert alert-soft alert-secondary items-start">
              {c.icon && <span class:list={[c.icon, 'size-6 shrink-0']}></span>}
              <div><p class="font-semibold">{c.title}</p><p class="text-sm">{c.text}</p></div>
            </div>
          ))}
        </div>
      </section>
    )}

    {llevas.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xl font-semibold">Lo que se lleva de cada bloque</h2>
        <div class="accordion accordion-bordered mt-4 divide-y divide-base-content/10 rounded-box" data-accordion-always-open="">
          {llevas.map((t, i) => (
            <div class="accordion-item" id={`lleva-${i}`}>
              <button type="button" class="accordion-toggle inline-flex w-full items-center gap-3 text-start" aria-controls={`lleva-${i}-body`} aria-expanded="false">
                <span class="flex-1 font-medium">{t.title}</span>
                <span class="icon-[tabler--chevron-down] accordion-item-active:rotate-180 size-5 shrink-0 transition-transform"></span>
              </button>
              <div id={`lleva-${i}-body`} class="accordion-content hidden w-full overflow-hidden transition-[height] duration-300" role="region" aria-labelledby={`lleva-${i}`}>
                <ul class="space-y-2 px-5 pb-4">
                  {t.bullets?.map((b) => <li class="flex gap-2"><span class="icon-[tabler--check] mt-1 size-4 shrink-0 text-secondary"></span>{b}</li>)}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="mt-10">
      <h2 class="text-xl font-semibold">Material del día</h2>
      <p class="mt-1 text-sm text-base-content/70">Las páginas que se usan en las diapositivas de hoy, en el orden en que aparecen.</p>
    </section>

    <section class="mt-4 grid gap-3 sm:grid-cols-2">
      <a href={href(`/participante/${deck.slug}/resumen/`)} class="card border border-secondary/50 bg-secondary/5 shadow-none transition hover:border-secondary sm:col-span-2">
        <div class="card-body flex-row items-center gap-4 p-5">
          <span class="icon-[tabler--printer] size-8 shrink-0 text-secondary"></span>
          <div><p class="font-semibold">Resumen de una página</p><p class="text-sm text-base-content/70">Para imprimir o guardar en PDF y llevar al servicio.</p></div>
        </div>
      </a>
      {material.map((m) => (
        <a href={href(m.path)} class="card border border-base-content/10 shadow-none transition hover:border-secondary">
          <div class="card-body flex-row items-center gap-4 p-5">
            <span class:list={[m.icon, 'size-8 shrink-0 text-secondary']}></span>
            <div><p class="font-semibold">{m.label}</p><p class="text-sm text-base-content/70">{momento(m.slide)}</p></div>
          </div>
        </a>
      ))}
    </section>

    {otros.length > 0 && (
      <p class="mt-10 text-sm text-base-content/70">
        Ver también: {otros.map((d, i) => <>{i > 0 && ' · '}<a class="link" href={href(`/participante/${d.slug}/`)}>Día {d.day}</a></>)}
      </p>
    )}
  </article>
  )}

  <script>
    // Lista del taller: cada participante marca su avance en su propio dispositivo
    document.querySelectorAll<HTMLElement>('[data-checklist]').forEach((list) => {
      const key = `check-${list.dataset.checklist}`
      let saved: number[] = []
      try {
        saved = JSON.parse(localStorage.getItem(key) ?? '[]')
        if (!Array.isArray(saved)) saved = []
      } catch {}
      const boxes = [...list.querySelectorAll<HTMLInputElement>('[data-check]')]
      boxes.forEach((b) => {
        b.checked = saved.includes(Number(b.dataset.check))
        b.addEventListener('change', () => {
          try {
            localStorage.setItem(key, JSON.stringify(boxes.filter((x) => x.checked).map((x) => Number(x.dataset.check))))
          } catch {}
        })
      })
    })
  </script>
</Layout>
