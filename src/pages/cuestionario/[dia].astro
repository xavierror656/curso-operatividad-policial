---
import Layout from '../../layouts/Layout.astro'
import { cuestionariosPractica } from '../../data/cuestionarios-practica'
import { href } from '../../lib/site'

export function getStaticPaths() {
  return [
    { params: { dia: 'dia-2' }, props: { quiz: cuestionariosPractica.dia2 } },
    { params: { dia: 'dia-3' }, props: { quiz: cuestionariosPractica.dia3 } },
  ]
}

type Quiz = {
  dia: number
  titulo: string
  descripcion: string
  preguntas: { pregunta: string; opciones: string[]; correcta: number; explicacion: string }[]
}
const { quiz } = Astro.props as { quiz: Quiz }
const otroDia = quiz.dia === 2 ? 3 : 2
const letras = ['a', 'b', 'c', 'd']
---

<Layout title={`${quiz.titulo} · Operatividad policial`} description={quiz.descripcion}>
  <article class="mx-auto max-w-3xl px-4 py-8 md:py-12">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-secondary">Cuestionario de repaso · Día {quiz.dia}</p>
    <h1 class="mt-2 text-3xl font-semibold md:text-4xl">{quiz.titulo}</h1>
    <p class="mt-3 text-base-content/75">{quiz.descripcion}</p>
    <p class="mt-2 text-sm text-base-content/70">{quiz.preguntas.length} preguntas · unos 5 minutos · resultado inmediato. No se pide nombre ni se guardan respuestas.</p>

    <nav class="mt-6 flex flex-wrap gap-2" aria-label="Otros cuestionarios">
      <a class="btn btn-outline btn-sm" href={href('/cuestionario/')}>Diagnóstico y cierre</a>
      <a class="btn btn-outline btn-sm" href={href(`/cuestionario/dia-${otroDia}/`)}>Repaso del Día {otroDia}</a>
    </nav>

    <form class="mt-8 space-y-6" data-quiz-practica novalidate>
      <ol class="space-y-6">
        {quiz.preguntas.map((item, i) => (
          <li>
            <fieldset class="rounded-box border border-base-content/15 p-5" data-pregunta data-correcta={item.correcta}>
              <legend class="px-1 font-display font-semibold"><span class="text-secondary">{i + 1}.</span> {item.pregunta}</legend>
              <div class="mt-2 grid gap-2">
                {item.opciones.map((opcion, j) => (
                  <label class="flex cursor-pointer items-start gap-3 rounded-box border border-base-content/15 p-3 has-checked:border-primary has-checked:bg-base-200" data-opcion={j}>
                    <input type="radio" name={`q${i}`} value={j} class="radio radio-primary radio-sm mt-0.5" />
                    <span><span class="me-1 text-base-content/60">{letras[j]})</span> {opcion}</span>
                  </label>
                ))}
              </div>
              <p class="mt-3 rounded-box bg-base-200 p-3 text-sm" data-explicacion hidden>
                <strong data-estado></strong> {item.explicacion}
              </p>
            </fieldset>
          </li>
        ))}
      </ol>
      <p class="alert alert-soft alert-error" data-error role="alert" hidden></p>
      <button type="submit" class="btn btn-primary btn-lg">Revisar respuestas</button>
    </form>

    <section class="mt-8 rounded-box border border-secondary/40 bg-secondary/5 p-5" data-resultado hidden tabindex="-1" aria-live="polite">
      <h2 class="font-display text-xl font-semibold">Resultado: <span data-puntaje></span> de {quiz.preguntas.length}</h2>
      <p class="mt-2 text-sm text-base-content/75">Revise las explicaciones marcadas arriba. Este repaso no cambia la calificación del curso.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline btn-sm" data-repetir>Intentarlo de nuevo</button>
        <a class="btn btn-secondary btn-sm" href={href(`/diapositivas/dia-${quiz.dia}/`)}>Repasar las diapositivas</a>
      </div>
    </section>
  </article>

  <script>
    const form = document.querySelector<HTMLFormElement>('[data-quiz-practica]')!
    const preguntas = [...form.querySelectorAll<HTMLElement>('[data-pregunta]')]
    const error = form.querySelector<HTMLElement>('[data-error]')!
    const resultado = document.querySelector<HTMLElement>('[data-resultado]')!

    form.addEventListener('submit', (event) => {
      event.preventDefault()
      const respuestas = new FormData(form)
      const faltante = preguntas.findIndex((_, i) => respuestas.get(`q${i}`) === null)
      if (faltante >= 0) {
        error.textContent = `Conteste la pregunta ${faltante + 1} antes de revisar.`
        error.hidden = false
        preguntas[faltante].querySelector<HTMLInputElement>('input')?.focus()
        return
      }
      error.hidden = true
      let puntaje = 0
      preguntas.forEach((pregunta, i) => {
        const correcta = Number(pregunta.dataset.correcta)
        const elegida = Number(respuestas.get(`q${i}`))
        const acierto = correcta === elegida
        if (acierto) puntaje++
        pregunta.querySelectorAll<HTMLElement>('[data-opcion]').forEach((opcion) => {
          const indice = Number(opcion.dataset.opcion)
          opcion.classList.toggle('border-success', indice === correcta)
          opcion.classList.toggle('border-error', indice === elegida && !acierto)
        })
        pregunta.querySelector<HTMLElement>('[data-estado]')!.textContent = acierto ? 'Correcto.' : `La respuesta correcta es ${'abcd'[correcta]}).`
        pregunta.querySelector<HTMLElement>('[data-explicacion]')!.hidden = false
      })
      resultado.querySelector<HTMLElement>('[data-puntaje]')!.textContent = String(puntaje)
      resultado.hidden = false
      resultado.focus()
    })

    resultado.querySelector<HTMLButtonElement>('[data-repetir]')!.addEventListener('click', () => {
      form.reset()
      preguntas.forEach((pregunta) => {
        pregunta.querySelector<HTMLElement>('[data-explicacion]')!.hidden = true
        pregunta.querySelectorAll<HTMLElement>('[data-opcion]').forEach((opcion) => opcion.classList.remove('border-success', 'border-error'))
      })
      resultado.hidden = true
      error.hidden = true
      form.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
    })
  </script>
</Layout>
