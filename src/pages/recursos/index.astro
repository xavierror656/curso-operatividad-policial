---
import Layout from '../../layouts/Layout.astro'
import { biblioteca } from '../../data/biblioteca'
import { href } from '../../lib/site'
const tipos = [...new Set(biblioteca.map(r => r.tipo))]
---
<Layout title="Biblioteca de recursos · Operatividad policial" description="Presentaciones, archivos, prácticas, repositorios y diagramas del curso en un solo lugar.">
  <section class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <a href={href('/')} class="link text-sm">Inicio del curso</a>
    <h1 class="mt-5 text-4xl font-semibold text-balance">Biblioteca de recursos</h1>
    <p class="mt-4 max-w-3xl text-lg">Encuentre la presentación de su sesión, descargue los archivos de práctica o repase un procedimiento con los diagramas.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={href('/diapositivas/')} class="btn btn-primary">Abrir presentaciones</a>
      <a href={href('/diagramas/')} class="btn btn-outline">Ver diagramas</a>
    </div>

    <form id="filtros" class="mt-10 grid gap-4 rounded-box bg-base-200 p-5 md:grid-cols-[2fr_1fr_1fr_auto]" role="search" aria-label="Buscar recursos" hidden>
      <label class="block"><span class="mb-2 block font-semibold">Buscar recurso</span><input id="busqueda" type="search" class="input w-full" placeholder="Por ejemplo: QGIS, CSV o gráficas" /></label>
      <label class="block"><span class="mb-2 block font-semibold">Tipo de recurso</span><select id="tipo" class="select w-full"><option value="">Todos los tipos</option>{tipos.map(t => <option>{t}</option>)}</select></label>
      <label class="block"><span class="mb-2 block font-semibold">Sesión</span><select id="dia" class="select w-full"><option value="">Todos los días</option>{[1, 2, 3].map(d => <option value={d}>Día {d}</option>)}</select></label>
      <button type="reset" class="btn btn-outline self-end">Limpiar filtros</button>
    </form>
    <noscript><p class="mt-6">Todos los recursos aparecen a continuación. Active JavaScript para usar los filtros.</p></noscript>
    <p id="conteo" role="status" aria-live="polite" aria-atomic="true" class="mt-6 text-sm">{biblioteca.length} recursos disponibles</p>
    <ul class="mt-3 border-t border-base-content/15" id="recursos">
      {biblioteca.map(r => (
        <li class="recurso border-b border-base-content/15 py-6" data-tipo={r.tipo} data-dias={r.dias.join(',')} data-busqueda={`${r.titulo} ${r.descripcion} ${r.formato} ${r.tipo}`}>
          <article class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div class="max-w-3xl">
              <p class="text-sm text-secondary">{r.tipo} · {r.formato} · {r.dias.length === 3 ? 'Todos los días' : r.dias.map(d => `Día ${d}`).join(', ')}</p>
              <h2 class="mt-1 text-xl font-semibold"><a class="resource-link" href={r.ruta.startsWith('https:') ? r.ruta : href(r.ruta)} download={r.descarga || undefined}>{r.titulo}</a></h2>
              <p class="mt-2">{r.descripcion}</p>
            </div>
            <a class="btn btn-outline shrink-0 self-start md:self-center" href={r.ruta.startsWith('https:') ? r.ruta : href(r.ruta)} download={r.descarga || undefined} aria-label={`${r.descarga ? 'Descargar' : 'Abrir'}: ${r.titulo}`}>{r.descarga ? `Descargar ${r.formato}` : 'Abrir recurso'}</a>
          </article>
        </li>
      ))}
    </ul>
    <p id="sin-resultados" hidden class="py-10 text-lg">No encontramos recursos con esos filtros. Pruebe otra palabra o seleccione «Limpiar filtros».</p>
    <aside class="mt-10 max-w-3xl">
      <h2 class="text-xl font-semibold">Repositorios de información</h2>
      <p class="mt-3">Los enlaces de GitHub necesitan internet. Los CSV de práctica son sintéticos y las capas geográficas tienen límites reales. Consulte el catálogo de archivos antes de combinarlos.</p>
      <p class="mt-3">El enlace a la carpeta compartida de Drive estará disponible cuando el instructor lo proporcione.</p>
    </aside>
  </section>
</Layout>
<style>
  [hidden] { display: none !important; }
  .resource-link { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: .2em; }
  .resource-link:hover { text-decoration-color: currentColor; }
  input { caret-color: var(--color-secondary); }
  ::selection { background: #191b2d; color: white; }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('#filtros')!
  const buscar = document.querySelector<HTMLInputElement>('#busqueda')!
  const tipo = document.querySelector<HTMLSelectElement>('#tipo')!
  const dia = document.querySelector<HTMLSelectElement>('#dia')!
  const filas = [...document.querySelectorAll<HTMLElement>('.recurso')]
  const normalizar = (texto: string) => texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
  const filtrar = () => {
    const palabras = normalizar(buscar.value).trim().split(/\s+/).filter(Boolean)
    let cantidad = 0
    for (const fila of filas) {
      const coincide = palabras.every(p => normalizar(fila.dataset.busqueda || '').includes(p)) && (!tipo.value || fila.dataset.tipo === tipo.value) && (!dia.value || fila.dataset.dias?.split(',').includes(dia.value))
      fila.hidden = !coincide
      if (coincide) cantidad++
    }
    document.querySelector('#conteo')!.textContent = `${cantidad} ${cantidad === 1 ? 'recurso disponible' : 'recursos disponibles'}`
    document.querySelector<HTMLElement>('#sin-resultados')!.hidden = cantidad !== 0
  }
  form.hidden = false
  form.addEventListener('submit', e => e.preventDefault())
  form.addEventListener('input', filtrar)
  form.addEventListener('change', filtrar)
  form.addEventListener('reset', () => { buscar.value = ''; tipo.value = ''; dia.value = ''; filtrar(); buscar.focus() })
</script>
