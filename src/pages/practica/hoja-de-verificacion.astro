---
import Layout from '../../layouts/Layout.astro'
import { verificacion } from '../../data/recursos'
---

<Layout title="Hoja de verificación · Operatividad policial" description="Lista interactiva para revisar un archivo, tablero o mapa antes de entregarlo.">
  <article class="mx-auto max-w-3xl px-4 py-8 md:py-12">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-secondary">Práctica · Uso en el trabajo</p>
    <h1 class="mt-2 text-3xl font-semibold md:text-4xl">Hoja de verificación</h1>
    <p class="mt-3 text-base-content/75">
      Revise cada punto antes de entregar un archivo, un tablero o un mapa. Las marcas se guardan solo en este dispositivo, así que también sirve después del curso.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-3 print:hidden">
      <div class="progress h-2 min-w-40 flex-1" role="progressbar" aria-label="Avance total" aria-valuemin="0" aria-valuemax="100" data-total-wrap>
        <div class="progress-bar progress-secondary" style="width:0%" data-total-bar></div>
      </div>
      <span class="text-sm tabular-nums text-base-content/70" data-total>0 de 0</span>
      <button type="button" class="btn btn-outline btn-sm" data-reset>Desmarcar todo</button>
      <button type="button" class="btn btn-secondary btn-sm" onclick="print()"><span class="icon-[tabler--printer] size-4"></span>Imprimir</button>
    </div>

    <div class="mt-8 space-y-6">
      {verificacion.map((g) => (
        <section id={g.id} class="card scroll-mt-24 border border-base-content/10 shadow-none" data-grupo={g.id}>
          <div class="card-body gap-3">
            <h2 class="flex items-center gap-3 font-display text-lg font-semibold">
              <span class={`${g.icon} size-6 text-secondary`}></span>{g.titulo}
              <span class="badge badge-soft ms-auto tabular-nums" data-count></span>
            </h2>
            <ul class="space-y-1">
              {g.items.map((it, i) => (
                <li>
                  <label class="flex cursor-pointer items-start gap-3 rounded-box p-2 hover:bg-base-200">
                    <input type="checkbox" class="checkbox checkbox-secondary mt-0.5" data-i={i} />
                    <span>{it}</span>
                  </label>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>
  </article>

  <script>
    // La clave cambia si cambian los puntos de la lista, para no marcar otro punto por error
    const hash = [...document.querySelectorAll('[data-grupo] li span')].map((x) => x.textContent).join('|').split('').reduce((h, c) => ((h << 5) - h + c.charCodeAt(0)) | 0, 0)
    const key = `verificacion-c3-${hash}`
    let saved: Record<string, number[]> = {}
    try {
      saved = JSON.parse(localStorage.getItem(key) ?? '{}')
    } catch {}
    const grupos = [...document.querySelectorAll<HTMLElement>('[data-grupo]')]
    const $ = (s: string) => document.querySelector<HTMLElement>(s)!

    const render = () => {
      let hechos = 0
      let total = 0
      for (const g of grupos) {
        const boxes = [...g.querySelectorAll<HTMLInputElement>('input')]
        const n = boxes.filter((b) => b.checked).length
        g.querySelector('[data-count]')!.textContent = `${n} / ${boxes.length}`
        g.querySelector('[data-count]')!.classList.toggle('badge-success', n === boxes.length)
        hechos += n
        total += boxes.length
      }
      const pct = total ? Math.round((hechos / total) * 100) : 0
      $('[data-total]').textContent = `${hechos} de ${total}`
      $('[data-total-bar]').style.width = `${pct}%`
      $('[data-total-wrap]').setAttribute('aria-valuenow', String(pct))
    }
    const persist = () => {
      const out: Record<string, number[]> = {}
      for (const g of grupos) out[g.dataset.grupo!] = [...g.querySelectorAll<HTMLInputElement>('input')].flatMap((b) => (b.checked ? [Number(b.dataset.i)] : []))
      try {
        localStorage.setItem(key, JSON.stringify(out))
      } catch {}
    }
    for (const g of grupos) {
      const marcadas = saved[g.dataset.grupo!] ?? []
      g.querySelectorAll<HTMLInputElement>('input').forEach((b) => {
        b.checked = marcadas.includes(Number(b.dataset.i))
        b.addEventListener('change', () => {
          persist()
          render()
        })
      })
    }
    $('[data-reset]').addEventListener('click', () => {
      document.querySelectorAll<HTMLInputElement>('[data-grupo] input').forEach((b) => (b.checked = false))
      persist()
      render()
    })
    render()
  </script>
</Layout>
