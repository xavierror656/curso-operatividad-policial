---
import Layout from '../../layouts/Layout.astro'
import { filasError } from '../../data/recursos'
import { href } from '../../lib/site'

const totalFallas = filasError.filter((f) => f.falla).length
---

<Layout title="Detecte las capturas inconsistentes · Operatividad policial" description="Práctica: marcar los registros defectuosos de una tabla ficticia.">
  <article class="mx-auto max-w-5xl px-4 py-8 md:py-12">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-secondary">Práctica · Calidad de datos</p>
    <h1 class="mt-2 text-3xl font-semibold md:text-4xl">Detecte las capturas inconsistentes</h1>
    <p class="mt-3 max-w-3xl text-base-content/75">
      Esta tabla ficticia tiene registros que no pasarían una revisión. Marque la casilla de cada fila que vea con problemas y pulse «Revisar». Hoy es 19 de octubre de 2026 y el catálogo de sectores va del 1 al 6.
    </p>

    <div class="mt-6 overflow-x-auto rounded-box border border-base-content/10">
      <table class="table table-sm">
        <caption class="sr-only">Registros ficticios de incidentes</caption>
        <thead>
          <tr><th scope="col"><span class="sr-only">Marcar</span></th><th scope="col">Folio</th><th scope="col">Fecha</th><th scope="col">Hora</th><th scope="col">Delito</th><th scope="col">Colonia</th><th scope="col">Sector</th><th scope="col">Lat.</th><th scope="col">Lon.</th></tr>
        </thead>
        <tbody>
          {filasError.map((f, i) => (
            <>
              <tr data-fila={i} data-falla={f.falla ?? ''}>
                <td><input type="checkbox" class="checkbox checkbox-secondary checkbox-sm" aria-label={`Marcar la fila ${i + 1} como defectuosa`} /></td>
                <td class="whitespace-nowrap">{f.folio}</td>
                <td class="whitespace-nowrap">{f.fecha}</td>
                <td>{f.hora}</td>
                <td>{f.delito}</td>
                <td><span class="whitespace-pre">{f.colonia}</span></td>
                <td>{f.sector}</td>
                <td>{f.lat || <em class="text-base-content/60">vacío</em>}</td>
                <td>{f.lon}</td>
              </tr>
              <tr data-exp={i} hidden><td></td><td colspan="8" class="text-sm"></td></tr>
            </>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-3">
      <button type="button" class="btn btn-primary" data-check><span class="icon-[tabler--search] size-5"></span>Revisar</button>
      <button type="button" class="btn btn-outline" data-reset>Reiniciar</button>
      <p class="text-sm" data-result role="status" aria-live="polite"></p>
    </div>

    <p class="mt-10 text-sm text-base-content/60">
      Esto mismo se automatiza en el Día 1 con Python. Revise también la <a class="link" href={href('/practica/hoja-de-verificacion/')}>hoja de verificación</a>.
    </p>
  </article>

  <script is:inline define:vars={{ totalFallas }}>
    const filas = [...document.querySelectorAll('[data-fila]')]
    const result = document.querySelector('[data-result]')
    document.querySelector('[data-check]').addEventListener('click', () => {
      let bien = 0, falsas = 0, omitidas = 0
      filas.forEach((tr) => {
        const marcada = tr.querySelector('input').checked
        const falla = tr.dataset.falla
        const exp = document.querySelector('[data-exp="' + tr.dataset.fila + '"]')
        tr.classList.remove('fila-ok', 'fila-mal')
        exp.hidden = true
        if (falla && marcada) { bien++; tr.classList.add('fila-ok'); exp.hidden = false; exp.lastElementChild.textContent = falla }
        else if (falla) { omitidas++; tr.classList.add('fila-mal'); exp.hidden = false; exp.lastElementChild.textContent = 'No la marcó. ' + falla }
        else if (marcada) { falsas++; tr.classList.add('fila-mal'); exp.hidden = false; exp.lastElementChild.textContent = 'Este registro está bien.' }
      })
      result.textContent = 'Detectó ' + bien + ' de ' + totalFallas + '. Omitió ' + omitidas + '. Marcó ' + falsas + ' registro(s) que estaba(n) bien.' + (bien === totalFallas && !falsas ? ' Revisión completa.' : '')
    })
    document.querySelector('[data-reset]').addEventListener('click', () => {
      filas.forEach((tr) => { tr.querySelector('input').checked = false; tr.classList.remove('fila-ok', 'fila-mal') })
      document.querySelectorAll('[data-exp]').forEach((e) => (e.hidden = true))
      result.textContent = ''
    })
  </script>

  <style is:global>
    tr.fila-ok { background: color-mix(in oklab, var(--color-success) 12%, transparent); }
    tr.fila-mal { background: color-mix(in oklab, var(--color-error) 12%, transparent); }
  </style>
</Layout>
